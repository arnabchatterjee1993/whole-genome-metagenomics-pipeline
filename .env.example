# Copy to .env (or export these in your shell) and edit the paths for your machine.
# config.py falls back to the defaults shown here if a variable isn't set.

PIPELINE_MASTER_DIR=./pipeline_run
PIPELINE_TOOLS_DIR=./tools

PIPELINE_BOWTIE2_BIN=./tools/bowtie2/bowtie2
PIPELINE_SAMTOOLS_BIN=./tools/samtools/samtools
PIPELINE_HUMAN_INDEX_DIR=./tools/bowtie2/GRCh38_noalt_as

PIPELINE_KRAKEN_EXE=./tools/kraken2/kraken2
PIPELINE_KRAKEN_DB=./tools/kraken2/kraken2_db

PIPELINE_METAPHLAN_DIR=./tools/metaphlan/bin
PIPELINE_METAPHLAN_BT2DB=./tools/metaphlan/metaphlan_bt2db
PIPELINE_METAPHLAN_INDEX=mpa_vJun23_CHOCOPhlAnSGB_202307

PIPELINE_DEEPARG_DIR=./tools/deeparg/bin
PIPELINE_DEEPARG_DB=./tools/deeparg_db

PIPELINE_THREADS=4
PIPELINE_TARGET_DEPTH=1000000
